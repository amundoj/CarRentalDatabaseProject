<!DOCTYPE html>
<html>
<head>
  <title>DAB - <%= title %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
  <script src="/js/common.js"></script>
</head>
<body>
  <%- include('./partials/navbar.ejs', { user: user }) %>

  <div class="container-fluid mt-5">
    <h2 class="p-3 text-center"><%= title %></h2>

    <!-- Navigation Buttons -->
    <div class="row px-3 py-1 w-100 text-center mb-3">
      <span class="col"><a href="/vehicles/popular" class="btn btn-success btn-sm">Popular Vehicle Types</a></span>
      <span class="col"><a href="/vehicles/rented" class="btn btn-success btn-sm">Currently Rented</a></span>
      <span class="col"><a href="/vehicles/service" class="btn btn-success btn-sm">Vehicles Requiring Service</a></span>
      <span class="col"><a href="/vehicles/cruise-control" class="btn btn-success btn-sm">Cruise Control</a></span>
      <span class="col"><a href="/vehicles" class="btn btn-warning btn-sm">All Vehicles</a></span>
    </div>

    <!-- Table Header -->
    <div class="row px-3 py-1 w-100 bg-noroff text-center">
      <span class="col">Id</span>
      <span class="col">Registration No.</span>
      <span class="col">Make</span>
      <span class="col">Model</span>
      <span class="col">Colour</span>
      <span class="col">Vehicle Type</span>
      <span class="col">Features</span>
      <span class="col">Last Service Date</span>
      <span class="col">Rented</span>
      <span class="col">Options</span>
    </div>

    <!-- Vehicle List -->
    <div id="vehicle-list">
      <% vehicles.forEach(function(vehicle) { %>
        <div class="row px-3 py-1 w-100 text-center" id="vehicle-<%= vehicle.id %>">
          <span class="col"><%= vehicle.id %></span>
          <span class="col"><%= vehicle.registrationNo %></span>
          <span class="col"><%= vehicle.make %></span>
          <span class="col"><%= vehicle.model %></span>
          <span class="col"><%= vehicle.colour ? vehicle.colour.name : 'N/A' %></span>
          <span class="col"><%= vehicle.type ? vehicle.type.name : 'N/A' %></span>
          <span class="col"><%= vehicle.features %></span>
          <span class="col"><%= new Date(vehicle.lastServiceDate).toISOString().split('T')[0] %></span>
          <span class="col"><%= vehicle.rented ? 'Yes' : 'No' %></span>
          <span class="col">
            <% if (!vehicle.rented) { %>
              <button class="btn btn-warning btn-sm" onclick="rentVehicle(<%= vehicle.id %>)">Rent</button>
            <% } else { %>
              <span>Rented</span>
            <% } %>
          </span>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>
