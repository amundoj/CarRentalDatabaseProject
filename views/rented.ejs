<!DOCTYPE html>
<html>
<head>
  <title>Rented Vehicles</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="/stylesheets/styles.css">
</head>
<body>
  <%- include('./partials/navbar.ejs', {user: user}) %>

  <div class="container-fluid mt-5">
    <h2 class="p-3 text-center">Rented Vehicles</h2>

    <div class="list-group">
      <div class="row px-3 py-1 w-100 bg-noroff text-center">
        <span class="col">Registration No.</span>
        <span class="col">Make</span>
        <span class="col">Model</span>
        <span class="col">Colour</span>
        <span class="col">Vehicle Type</span>
        <span class="col">Features</span>
        <span class="col">Rental Start Date</span>
      </div>

      <% rentals.forEach(function(rental) { %>
        <div class="row px-3 py-1 w-100 text-center">
          <span class="col"><%= rental.Vehicle.registrationNo %></span>
          <span class="col"><%= rental.Vehicle.make %></span>
          <span class="col"><%= rental.Vehicle.model %></span>
          <span class="col"><%= rental.Vehicle.colour ? rental.Vehicle.colour.name : 'N/A' %></span>
          <span class="col"><%= rental.Vehicle.type ? rental.Vehicle.type.name : 'N/A' %></span>
          <span class="col"><%= rental.Vehicle.features %></span>
          <span class="col"><%= rental.startDate.toISOString().split('T')[0] %></span>
        </div>
      <% }); %>
    </div>
  </div>
</body>
</html>
